# BUSY Bar Screen Saver configuration
# Copy this file to .env to customize settings.

# BUSY Bar connection: USB default is 10.0.4.20. For Wi-Fi, use your bar's LAN IP.
BUSYBAR_IP=10.0.4.20

# Optional Wi-Fi HTTP API access password (set on your bar at Network -> HTTP API)
BUSYBAR_PASSWORD=

# Seconds to display each scene before cycling (default: 10)
SCREENSAVER_INTERVAL=10

# Playback order: true = shuffled randomly, false = alphabetical / folder order
SCREENSAVER_SHUFFLE=true

# Frames per second for animated scenes (default: 4)
SCREENSAVER_FPS=4

# Custom scenes folder path (default: scenes)
SCREENSAVER_SCENES_DIR=scenes
