# Shared BUSY Bar settings used by every app.
# Copy this file to .env in this folder. The .env file is ignored by git.
# Values here win over the same setting in an app's own .env.

# BUSY Bar connection: USB default is 10.0.4.20. For Wi-Fi, use your bar's LAN IP.
# Apps update this automatically when you enter a new IP after a failed connection.
BUSYBAR_IP=10.0.4.20

# Optional Wi-Fi HTTP API access password (set on your bar at Network -> HTTP API)
BUSYBAR_PASSWORD=
